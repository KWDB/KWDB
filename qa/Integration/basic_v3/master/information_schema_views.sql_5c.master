> SELECT table_name, column_name, data_type, is_tag,
       declared_data_type, declared_numeric_precision,
       declared_numeric_scale, is_system_time_period_start,
       is_system_time_period_end,
       system_time_period_timestamp_generation
FROM is_rel_db.information_schema.columns
WHERE table_schema = 'public'
  AND table_name = 'rel_table'
ORDER BY ordinal_position;
  table_name | column_name |     data_type     | is_tag | declared_data_type | declared_numeric_precision | declared_numeric_scale | is_system_time_period_start | is_system_time_period_end | system_time_period_timestamp_generation
-------------+-------------+-------------------+--------+--------------------+----------------------------+------------------------+-----------------------------+---------------------------+------------------------------------------
  rel_table  | id          | integer           | NO     | INT4               |                         32 |                      0 | NO                          | NO                        | NULL
  rel_table  | amount      | numeric           | NO     | DECIMAL(10,2)      |                         10 |                      2 | NO                          | NO                        | NULL
  rel_table  | name        | character varying | NO     | VARCHAR(20)        |                       NULL |                   NULL | NO                          | NO                        | NULL
(3 rows)
> SELECT table_name, column_name, data_type, is_tag,
       declared_data_type, declared_numeric_precision,
       declared_numeric_scale
FROM is_ts_db.information_schema.columns
WHERE table_schema = 'public'
  AND table_name IN ('ts_table', 'sparse_table')
ORDER BY table_name, ordinal_position;
   table_name  | column_name |        data_type         | is_tag | declared_data_type | declared_numeric_precision | declared_numeric_scale
---------------+-------------+--------------------------+--------+--------------------+----------------------------+-------------------------
  sparse_table | ts          | timestamp with time zone | NO     | TIMESTAMPTZ(3)     |                       NULL |                   NULL
  sparse_table | value       | integer                  | NO     | INT4               |                         32 |                      0
  sparse_table | host        | character varying        | YES    | VARCHAR(20)        |                       NULL |                   NULL
  ts_table     | ts          | timestamp with time zone | NO     | TIMESTAMPTZ(3)     |                       NULL |                   NULL
  ts_table     | value       | integer                  | NO     | INT4               |                         32 |                      0
  ts_table     | host        | character varying        | YES    | VARCHAR(20)        |                       NULL |                   NULL
(6 rows)
