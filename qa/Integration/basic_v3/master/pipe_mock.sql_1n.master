> drop database if exists pipe_db_fvt2 cascade;
DROP DATABASE
> create ts database pipe_db_fvt2;
CREATE TS DATABASE
> create table defaultdb.mock_sink_to_db (topic string not null,kind string,db_name string,tb_name string,key int8,data string);
CREATE TABLE
> CREATE TABLE pipe_db_fvt2.t1
(
    k_timestamp TIMESTAMPTZ NOT NULL,
    id          INT         NOT NULL,
    e1          INT2,
    e2          INT,
    e3          INT8,
    e4          FLOAT4,
    e5          FLOAT8,
    e6          BOOL,
    e7          TIMESTAMPTZ,
    e8          CHAR(1023),
    e9          NCHAR(255),
    e10         VARCHAR(4096),
    e11         CHAR,
    e12         CHAR(255),
    e13         NCHAR,
    e14         NVARCHAR(4096),
    e15         VARCHAR(1023),
    e16         NVARCHAR(200),
    e17         NCHAR(255),
    e18         CHAR(200),
    e19         VARBYTES,
    e20         VARBYTES(60),
    e21         VARCHAR,
    e22         NVARCHAR
) ATTRIBUTES (code1 INT2 NOT NULL,code2 INT,code3 INT8,
            code4 FLOAT4 ,code5 FLOAT8,
                        code6 BOOL,
                        code7 VARCHAR,code8 VARCHAR(128) NOT NULL,
                        code9 VARBYTES,code10 VARBYTES(60),
                        code11 VARCHAR,code12 VARCHAR(60),
                        code13 CHAR(2),code14 CHAR(1023) NOT NULL,
                        code15 NCHAR,code16 NCHAR(254) NOT NULL)
PRIMARY TAGS(code1,code14,code8,code16);
CREATE TABLE
> CREATE TABLE pipe_db_fvt2.t2
(
    k_timestamp TIMESTAMPTZ NOT NULL,
    id          INT         NOT NULL,
    e1          INT2,
    e2          INT,
    e3          INT8,
    e4          FLOAT4,
    e5          FLOAT8,
    e6          BOOL,
    e7          TIMESTAMPTZ,
    e8          CHAR(1023),
    e9          NCHAR(255),
    e10         VARCHAR(4096),
    e11         CHAR,
    e12         CHAR(255),
    e13         NCHAR,
    e14         NVARCHAR(4096),
    e15         VARCHAR(1023),
    e16         NVARCHAR(200),
    e17         NCHAR(255),
    e18         CHAR(200),
    e19         VARBYTES,
    e20         VARBYTES(60),
    e21         VARCHAR,
    e22         NVARCHAR
) ATTRIBUTES (code1 INT2 NOT NULL,code2 INT,code3 INT8,
            code4 FLOAT4 ,code5 FLOAT8,
                        code6 BOOL,
                        code7 VARCHAR,code8 VARCHAR(128) NOT NULL,
                        code9 VARBYTES,code10 VARBYTES(60),
                        code11 VARCHAR,code12 VARCHAR(60),
                        code13 CHAR(2),code14 CHAR(1023) NOT NULL,
                        code15 NCHAR,code16 NCHAR(254) NOT NULL)
PRIMARY TAGS(code1,code14,code8,code16);
CREATE TABLE
> create pipe test_pipe_mock1 for table pipe_db_fvt2.t1(*)
       where e1 > 50 with options
       (enable='off',buffer_size='0',ignore_history='off',
       sink='mock://root@127.0.102.145:26257?topic_name=test_topic_mock1&mock_sink_to_db=defaultdb.mock_sink_to_db');
CREATE PIPE
> CREATE PIPE test_pipe_mock2 FOR TABLE pipe_db_fvt2.t1(*)
      WHERE code1=0 AND code8='a' AND code14='w' AND code16='a'
      WITH OPTIONS (enable='off',sink='mock://root@127.0.102.145:26257?topic_name=test_topic_mock2&mock_sink_to_db=defaultdb.mock_sink_to_db');
