> SET DATABASE = is_views_03;
SET
> CREATE TABLE base_table (
    id INT PRIMARY KEY,
    value VARCHAR(8)
);
CREATE TABLE
> CREATE TABLE trigger_log (id INT PRIMARY KEY);
CREATE TABLE
> CREATE VIEW direct_view AS
SELECT id, value FROM base_table;
CREATE VIEW
> CREATE VIEW nested_view AS
SELECT id FROM direct_view;
CREATE VIEW
> CREATE PROCEDURE is_views_03_proc(proc_id INT, proc_name VARCHAR(5)) BEGIN SELECT proc_id; END;
CREATE PROCEDURE
> CREATE TRIGGER is_views_03_before_insert BEFORE INSERT ON base_table FOR EACH ROW BEGIN INSERT INTO trigger_log VALUES (NEW.id); END;
CREATE TRIGGER
> SELECT specific_catalog, specific_schema, specific_name,
       routine_catalog, routine_schema, routine_name, routine_type,
       routine_body, external_language, routine_definition IS NOT NULL AS has_definition,
       dtd_identifier, definer
FROM information_schema.routines
WHERE routine_name = 'is_views_03_proc';
