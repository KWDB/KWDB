> create view v_sensor_event_join as
select d.ts, d.temperature, d.device_id, e.event_level, e.event_name
from sensor_data d
join sensor_event e on d.device_id = e.device_id and d.ts = e.ts
where e.event_level >= 2;
CREATE VIEW
