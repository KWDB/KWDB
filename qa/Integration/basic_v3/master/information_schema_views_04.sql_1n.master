> SELECT table_catalog, table_schema, table_name,
       partition_name, subpartition_name,
       partition_ordinal_position, subpartition_ordinal_position,
       partition_method, subpartition_method,
       partition_expression, subpartition_expression,
       partition_description
FROM kwdb_internal.partitions
WHERE table_catalog = 'is_views_04'
  AND table_schema = 'is_views_04_schema'
  AND table_name IN (
      'list_partition_table',
      'range_partition_table',
      'hash_partition_table'
  )
ORDER BY table_name, partition_ordinal_position;
  table_catalog |    table_schema    |      table_name       | partition_name | subpartition_name | partition_ordinal_position | subpartition_ordinal_position | partition_method | subpartition_method | partition_expression | subpartition_expression | partition_description
----------------+--------------------+-----------------------+----------------+-------------------+----------------------------+-------------------------------+------------------+---------------------+----------------------+-------------------------+------------------------
