> CREATE TABLE is_views_04_schema.list_partition_table (
    region INT,
    id INT,
    PRIMARY KEY (region, id)
) PARTITION BY LIST (region) (
    PARTITION p_east VALUES IN (1),
    PARTITION p_west VALUES IN (2)
);
CREATE TABLE
> CREATE TABLE is_views_04_schema.range_partition_table (
    id INT PRIMARY KEY
) PARTITION BY RANGE (id) (
    PARTITION p_low VALUES FROM (1) TO (10),
    PARTITION p_high VALUES FROM (10) TO (20)
);
CREATE TABLE
> CREATE TABLE is_views_04_schema.hash_partition_table (
    bucket INT PRIMARY KEY
) PARTITION BY HASH (bucket) (
    PARTITION p_hash_0 VALUES IN (0),
    PARTITION p_hash_1 VALUES IN (1)
);
CREATE TABLE
