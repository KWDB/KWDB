> SELECT count(*) > 0 AS has_current_root_query
FROM information_schema.processlist
WHERE "USER" = 'root'
  AND length(id) = 32
  AND command = 'Query'
  AND "time" >= 0
  AND state IN ('PREPARING', 'EXECUTING')
  AND info LIKE '%information_schema.processlist%';
