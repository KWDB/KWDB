> SELECT schema_name, table_name, column_name,
       histogram->>'histogram-type' AS histogram_type,
       (histogram->>'number-of-buckets-specified')::INT AS bucket_count,
       (histogram->>'null-values')::DECIMAL = 0.2 AS null_fraction_matches,
       histogram->>'data-type' AS data_type
FROM information_schema.column_statistics
WHERE schema_name = 'is_views_04_schema'
  AND table_name = 'statistics_table'
ORDER BY column_name;
