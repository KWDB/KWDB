> SELECT table_name,
       partition_description =
           coalesce(list_value, range_value, hash_value)
           AS description_matches_legacy_value,
       table_rows IS NULL
           AND avg_row_length IS NULL
           AND data_length IS NULL
           AND max_data_length IS NULL
           AND index_length IS NULL
           AND data_free IS NULL
           AS size_fields_are_null,
       create_time IS NULL
           AND update_time IS NULL
           AND check_time IS NULL
           AND checksum IS NULL
           AND partition_comment IS NULL
           AND nodegroup IS NULL
           AND tablespace_name IS NULL
           AS unsupported_fields_are_null
FROM kwdb_internal.partitions
WHERE table_catalog = 'is_views_04'
  AND table_schema = 'is_views_04_schema'
ORDER BY table_name, partition_ordinal_position;
       table_name       | description_matches_legacy_value | size_fields_are_null | unsupported_fields_are_null
