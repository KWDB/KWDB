SET
> CREATE TEMP TABLE temp_is_table (id INT);
CREATE TABLE
> SELECT table_name, table_type, is_insertable_into,
       engine, row_format, table_comment
FROM is_rel_db.information_schema.tables
WHERE table_schema = 'public'
ORDER BY table_name;
   table_name  |    table_type     | is_insertable_into |   engine   | row_format |      table_comment
---------------+-------------------+--------------------+------------+------------+---------------------------
  rel_mat_view | MATERIALIZED VIEW | NO                 | NULL       | NULL       | VIEW
  rel_table    | BASE TABLE        | YES                | RELATIONAL | ROW        | relational table comment
  rel_view     | VIEW              | NO                 | NULL       | NULL       | VIEW
(3 rows)
> SELECT table_name, update_time IS NOT NULL AS has_update_time
FROM is_rel_db.information_schema.tables
WHERE table_schema = 'public'
  AND table_name IN ('rel_table', 'rel_view', 'rel_mat_view')
ORDER BY table_name;
   table_name  | has_update_time
---------------+------------------
  rel_mat_view |      true
  rel_table    |      true
  rel_view     |      true
