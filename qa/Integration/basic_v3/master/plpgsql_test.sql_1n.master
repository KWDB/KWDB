> CREATE FUNCTION calc_elsif(a INT)
    RETURNS INT
    LANGUAGE SQL
BEGIN
IF a < 0 THEN
SELECT -1;
ELSIF a = 0 THEN
SELECT 0;
ELSE
SELECT 1;
ENDIF;
