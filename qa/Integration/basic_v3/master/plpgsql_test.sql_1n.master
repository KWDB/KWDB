> CREATE FUNCTION loop_leave_sum(n INT)
    RETURNS INT
    LANGUAGE SQL
BEGIN
DECLARE i INT;
DECLARE s INT;

SET i = 0;
SET s = 0;

label my_loop: WHILE i < n DO
  SET i = i + 1;

  IF i > 3 THEN
    LEAVE my_loop;
  ENDIF;

  SET s = s + i;
ENDWHILE my_loop;

SELECT s;
END ;
CREATE FUNCTION
