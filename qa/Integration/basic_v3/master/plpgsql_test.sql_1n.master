> CREATE FUNCTION complex_control_flow(n INT)
    RETURNS INT
    LANGUAGE SQL
BEGIN
DECLARE i INT;
DECLARE s INT;

SET i = 0;
SET s = 0;

label main_loop: WHILE i < n DO
  SET i = i + 1;

  IF i = 2 THEN
    SET s = s + 20;
  ELSIF i = 4 THEN
    LEAVE main_loop;
ELSE
    SET s = s + i;
  ENDIF;
ENDWHILE main_loop;

SELECT s;
END ;
CREATE FUNCTION
> SELECT complex_control_flow(10) = 24;
  ?column?
------------
    true
(1 row)
