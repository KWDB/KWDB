> CREATE FUNCTION calc_loop(n INT)
RETURNS INT
LANGUAGE SQL
BEGIN
DECLARE i INT;
DECLARE s INT;
SET i = 0;
SET s = 0;
WHILE i < n DO
SET i = i + 1;
SET s = s + i;
ENDWHILE;
SELECT s;
END ;
CREATE FUNCTION
