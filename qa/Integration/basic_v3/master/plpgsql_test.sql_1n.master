> CREATE FUNCTION calc_multi_elsif(a INT)
    RETURNS INT
    LANGUAGE SQL
BEGIN
IF a < 0 THEN
SELECT -1;
ELSIF a = 0 THEN
SELECT 0;
ELSIF a = 1 THEN
SELECT 10;
ELSE
SELECT 100;
ENDIF;
END ;
CREATE FUNCTION
