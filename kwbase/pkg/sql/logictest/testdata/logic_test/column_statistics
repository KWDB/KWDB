# The generated single-column histogram uses the supported MySQL JSON keys and
# omits unavailable metadata.
query TTTTIBB
SELECT schema_name,
       table_name,
       column_name,
       histogram->>'histogram-type',
       (histogram->>'number-of-buckets-specified')::INT,
       histogram ? 'sampling-rate',
       histogram ? 'collation-id'
  FROM information_schema.column_statistics
 WHERE table_name = 'visible_stats'
 ORDER BY column_name
----
public  visible_stats  value  singleton  3  false  false

query BBT
SELECT (histogram->>'null-values')::DECIMAL = 0.2,
       jsonb_array_length(histogram->'buckets') > 0,
       histogram->>'data-type'
  FROM information_schema.column_statistics
 WHERE table_name = 'visible_stats' AND column_name = 'value'
----
true  true  int

# More distinct values than the histogram bucket limit produce an equi-height
# histogram. The first bucket has equal display bounds, later buckets reuse the
# preceding upper bound, cumulative frequencies increase, and the final one is 1.
query TIBBBB
SELECT histogram->>'histogram-type',
       (histogram->>'number-of-buckets-specified')::INT,
       histogram->'buckets'->0->>0 = histogram->'buckets'->0->>1,
       histogram->'buckets'->0->>1 = histogram->'buckets'->1->>0,
       (histogram->'buckets'->1->>2)::DECIMAL > (histogram->'buckets'->0->>2)::DECIMAL,
       (histogram->'buckets'->199->>2)::DECIMAL = 1
  FROM information_schema.column_statistics
 WHERE table_name = 'equi_height_stats' AND column_name = 'value'
----
equi-height  200  true  true  true  true

