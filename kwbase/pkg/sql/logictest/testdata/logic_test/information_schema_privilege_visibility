# Schema privileges use the same grantee filter while preserving database-level values.
query TT rowsort
SELECT grantee, privilege_type
  FROM information_schema.schema_privileges
 WHERE table_schema = 'public'
----
privilege_visibility_direct_role  ALL
privilege_visibility_parent_role  UPDATE
testuser                           SELECT
public                            SELECT

