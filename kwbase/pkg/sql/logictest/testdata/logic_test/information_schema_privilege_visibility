privilege_visibility_direct_role  a  SELECT
privilege_visibility_direct_role  a  UPDATE
privilege_visibility_direct_role  b  INSERT
privilege_visibility_direct_role  b  SELECT
privilege_visibility_direct_role  b  UPDATE
privilege_visibility_parent_role  a  UPDATE
privilege_visibility_parent_role  b  UPDATE
