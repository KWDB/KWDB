statement ok
SET DATABASE = privilege_visibility_test

# Administrators can inspect grants of otherwise unrelated roles.
query T rowsort
SELECT DISTINCT grantee
  FROM information_schema.role_table_grants
 WHERE table_schema = 'public'
   AND table_name = 'privilege_matrix'
   AND grantee IN (
     'privilege_visibility_direct_role',
     'privilege_visibility_parent_role',
     'privilege_visibility_unrelated_role',
     'public'
   )
----
privilege_visibility_direct_role
privilege_visibility_parent_role
privilege_visibility_unrelated_role
public

